<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tromuwelle.Content" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#080B20</item>
        <item name="android:navigationBarColor">#080B20</item>
        <item name="android:windowLightStatusBar">false</item>
